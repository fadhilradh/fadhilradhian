# ── Database (Neon, Singapore region) ─────────────────────────────────────────
# Pooled connection string for the API; unpooled for migrations.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/niaga?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/niaga?sslmode=require"

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"
LOG_LEVEL="info"
# Comma-separated list. Must include the Netlify deploy origin in production.
CORS_ORIGINS="http://localhost:5173"
PUBLIC_WEB_URL="http://localhost:5173"

# ── Auth (phase 1 — Better Auth) ──────────────────────────────────────────────
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3001"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Storage (Cloudflare R2 — phase 2) ─────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PUBLIC="niaga-media"
R2_BUCKET_PRIVATE="niaga-documents"
R2_PUBLIC_BASE_URL="https://media.niaga.example"

# ── Rate limiting (Upstash Redis — the only thing Redis is used for) ──────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Email (Resend — phase 4) ──────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Niaga <noreply@niaga.example>"

# ── Web (Vite; only VITE_* is exposed to the browser) ─────────────────────────
VITE_API_URL="http://localhost:3001"
